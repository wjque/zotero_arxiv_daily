# Keep real values in your environment or credential manager. Never commit a .env file.
ZAD_ZOTERO_BASE_URL=http://127.0.0.1:23119
ZAD_LOCAL_DATABASE_PATH=runtime/zotero.sqlite3
ZAD_DEEPSEEK_API_KEY=
ZAD_DEEPSEEK_TIMEOUT_SECONDS=60
ZAD_RECOMMENDATION_CANDIDATE_LIMIT=40
ZAD_AUTHOR_PREFERENCE_BONUS=0.75
ZAD_INSTITUTION_PREFERENCE_BONUS=0.5
ZAD_IDENTITY_BONUS_CAP=1.0
ZAD_RECOMMENDATION_SUPPRESSION_DAYS=14
ZAD_FEEDBACK_ACTIVATION_INTERVAL_DAYS=7
ZAD_FEEDBACK_MINIMUM_INDEPENDENT_PAPERS=3
ZAD_RANKING_WEIGHT_STATE_PATH=runtime/ranking-weights.json
ZAD_LLM_REFINEMENT_ENABLED=false
ZAD_LLM_PREFERENCE_CONTEXT_APPROVED=false
ZAD_LLM_JUDGE_BATCH_SIZE=40
ZAD_LLM_EXPLANATION_BATCH_SIZE=20
ZAD_LLM_REQUEST_TOKEN_LIMIT=12000
ZAD_LLM_REQUEST_BYTE_LIMIT=65536
ZAD_LLM_MAX_REQUESTS=4
ZAD_LLM_RETRIES=1
ZAD_LLM_MAX_OUTPUT_TOKENS=12000
ZAD_GITHUB_REPOSITORY=owner/repository
ZAD_GITHUB_TOKEN=
ZAD_PAGES_PASSPHRASE=
ZAD_STATE_ENCRYPTION_KEY=
ZAD_PUBLIC_OUTPUT=false
ZAD_OUTPUT_LANGUAGE=en
